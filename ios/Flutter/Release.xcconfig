#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Firebase and pods header search paths
HEADER_SEARCH_PATHS = $(inherited) $(PODS_ROOT)/Headers/Public $(PODS_ROOT)/Headers/Public/GoogleUtilities

// Allow non-modular headers (critical for Firebase)
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES

// Disable bitcode
ENABLE_BITCODE = NO
